<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="lr4-sequence" name="LR4 Sequence"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Диаграмма последовательности — ЛР4: авторизация и сессии" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="70" y="15" width="1150" height="40" as="geometry" /></mxCell><mxCell id="user_head" value="Пользователь" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="60" y="80" width="160" height="42" as="geometry" /></mxCell><mxCell id="user_line" value="" style="shape=line;strokeColor=#666666;dashed=1;dashPattern=4 4;html=1;" parent="1" vertex="1"><mxGeometry x="140" y="122" width="0" height="760" as="geometry" /></mxCell><mxCell id="browser_head" value="Браузер" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="300" y="80" width="160" height="42" as="geometry" /></mxCell><mxCell id="browser_line" value="" style="shape=line;strokeColor=#666666;dashed=1;dashPattern=4 4;html=1;" parent="1" vertex="1"><mxGeometry x="380" y="122" width="0" height="760" as="geometry" /></mxCell><mxCell id="api_head" value="FastAPI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="540" y="80" width="160" height="42" as="geometry" /></mxCell><mxCell id="api_line" value="" style="shape=line;strokeColor=#666666;dashed=1;dashPattern=4 4;html=1;" parent="1" vertex="1"><mxGeometry x="620" y="122" width="0" height="760" as="geometry" /></mxCell><mxCell id="db_head" value="PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="780" y="80" width="160" height="42" as="geometry" /></mxCell><mxCell id="db_line" value="" style="shape=line;strokeColor=#666666;dashed=1;dashPattern=4 4;html=1;" parent="1" vertex="1"><mxGeometry x="860" y="122" width="0" height="760" as="geometry" /></mxCell><mxCell id="redis_head" value="Redis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1"><mxGeometry x="1020" y="80" width="160" height="42" as="geometry" /></mxCell><mxCell id="redis_line" value="" style="shape=line;strokeColor=#666666;dashed=1;dashPattern=4 4;html=1;" parent="1" vertex="1"><mxGeometry x="1100" y="122" width="0" height="760" as="geometry" /></mxCell><mxCell id="msg0" value="1. Открыть форму регистрации" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="150" as="sourcePoint" /><mxPoint x="380" y="150" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg1" value="2. GET /auth/register" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="190" as="sourcePoint" /><mxPoint x="620" y="190" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg2" value="3. HTML-форма регистрации" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="225" as="sourcePoint" /><mxPoint x="380" y="225" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg3" value="4. Ввести имя и пароль" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="260" as="sourcePoint" /><mxPoint x="380" y="260" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg4" value="5. POST /auth/register" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="295" as="sourcePoint" /><mxPoint x="620" y="295" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg5" value="6. Проверить уникальность username" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="330" as="sourcePoint" /><mxPoint x="860" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg6" value="7. Пользователь отсутствует / доступен" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="365" as="sourcePoint" /><mxPoint x="620" y="365" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg7" value="8. INSERT users (хеш пароля, role=user)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="400" as="sourcePoint" /><mxPoint x="860" y="400" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg8" value="9. Новый пользователь" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="435" as="sourcePoint" /><mxPoint x="620" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg9" value="10. 303 Redirect на /auth/login" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="470" as="sourcePoint" /><mxPoint x="380" y="470" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg10" value="11. Ввести учётные данные" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="505" as="sourcePoint" /><mxPoint x="380" y="505" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg11" value="12. POST /api/users/auth или /auth/login" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="540" as="sourcePoint" /><mxPoint x="620" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg12" value="13. Найти пользователя и проверить хеш" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="575" as="sourcePoint" /><mxPoint x="860" y="575" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg13" value="14. user id + role" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="610" as="sourcePoint" /><mxPoint x="620" y="610" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg14" value="15. Сохранить session:&lt;token&gt; с TTL" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="645" as="sourcePoint" /><mxPoint x="1100" y="645" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg15" value="16. Redis подтверждает запись" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="680" as="sourcePoint" /><mxPoint x="620" y="680" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg16" value="17. Set-Cookie: HttpOnly, SameSite=Lax" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="715" as="sourcePoint" /><mxPoint x="380" y="715" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg17" value="18. Запрос защищённого ресурса" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="750" as="sourcePoint" /><mxPoint x="380" y="750" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg18" value="19. Cookie greenhouse_session" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="785" as="sourcePoint" /><mxPoint x="620" y="785" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg19" value="20. Проверить токен в Redis" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="820" as="sourcePoint" /><mxPoint x="1100" y="820" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg20" value="21. user_id сессии" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="855" as="sourcePoint" /><mxPoint x="620" y="855" as="targetPoint" /></mxGeometry></mxCell><mxCell id="msg21" value="22. Проверить роль и выполнить действие" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.3;dashed=1;strokeColor=#666666;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="890" as="sourcePoint" /><mxPoint x="380" y="890" as="targetPoint" /></mxGeometry></mxCell><mxCell id="logout_note" value="Выход: POST /api/users/deauth или /auth/logout → удаление session:&lt;token&gt; в Redis → очистка cookie → Redirect на страницу входа." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;align=left;spacing=10;" parent="1" vertex="1"><mxGeometry x="60" y="920" width="1120" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>